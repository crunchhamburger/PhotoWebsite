---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EpisodeMeta from '../../components/EpisodeMeta.astro';
import { podcast } from '../../site.config';
import { getEpisodes, audioPath } from '../../lib/podcast';

const episodes = await getEpisodes();
---
<BaseLayout title="Podcast" description={podcast.description}>
  <link slot="head" rel="alternate" type="application/rss+xml" title={podcast.title} href="/podcast/rss.xml" />

  <section class="podcast container">
    <header class="intro">
      <p class="eyebrow">Podcast</p>
      <h1 class="title">Market Brief</h1>
      <p class="lede">{podcast.description}</p>
      <a class="rss" href="/podcast/rss.xml">
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false">
          <path d="M5 11a8 8 0 0 1 8 8M5 5a14 14 0 0 1 14 14" />
          <circle cx="6" cy="18" r="1.4" />
        </svg>
        Subscribe with RSS
      </a>
    </header>

    {episodes.length === 0 ? (
      <p class="empty">No episodes yet.</p>
    ) : (
      <ol class="episodes" aria-label="Episodes, newest first">
        {episodes.map((ep) => (
          <li>
            <article class="episode" aria-labelledby={`ep-${ep.id}`}>
              <EpisodeMeta episode={ep} />
              <h2 class="headline" id={`ep-${ep.id}`}>
                <a href={`/podcast/${ep.id}`}>{ep.data.headline}</a>
              </h2>
              <audio controls preload="none" src={audioPath(ep)} aria-label={`Play: ${ep.data.title}`}></audio>
              <a class="more eyebrow" href={`/podcast/${ep.id}`} aria-label={`Show notes: ${ep.data.title}`}>
                Show notes <span aria-hidden="true">→</span>
              </a>
            </article>
          </li>
        ))}
      </ol>
    )}

    <p class="disclaimer">{podcast.disclaimer}</p>
  </section>
</BaseLayout>

<style>
  .podcast {
    max-width: calc(860px + 2 * var(--gutter));
    padding-block: clamp(40px, 7vw, 104px) 0;
  }

  .intro .eyebrow { margin: 0 0 18px; }
  .title {
    font-size: clamp(2.4rem, 1.4rem + 4.4vw, 5.25rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.02;
  }
  .lede {
    margin: clamp(20px, 2.6vw, 32px) 0 0;
    max-width: 38em;
    font-size: clamp(1rem, 0.96rem + 0.25vw, 1.15rem);
    line-height: 1.7;
    font-weight: 300;
    color: var(--fg-muted);
    text-wrap: pretty;
  }
  .rss {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 22px;
    font-size: 0.875rem;
    color: var(--fg);
    border-bottom: 1px solid var(--line);
    padding-bottom: 2px;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .rss:hover { color: var(--accent); border-color: currentColor; }
  .rss svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  .rss circle { fill: currentColor; stroke: none; }

  .episodes {
    list-style: none;
    margin: clamp(40px, 6vw, 72px) 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .episode {
    display: grid;
    gap: 14px;
    padding-block: clamp(24px, 3.5vw, 40px);
    border-bottom: 1px solid var(--line);
  }
  .headline {
    font-size: clamp(1.2rem, 1.11rem + 0.42vw, 1.5rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.005em;
    text-wrap: pretty;
  }
  .headline a {
    background: linear-gradient(currentColor, currentColor) no-repeat left bottom / 0 1px;
    transition: background-size 0.5s var(--ease), color 0.25s var(--ease);
  }
  .headline a:hover { background-size: 100% 1px; }

  audio {
    display: block;
    width: 100%;
    height: 44px;
    margin-top: 4px;
  }

  .more {
    justify-self: start;
    display: inline-flex;
    gap: 0.6em;
    font-size: 0.6875rem;
    transition: color 0.2s var(--ease);
  }
  .more:hover { color: var(--fg); }

  .empty { margin-top: 48px; color: var(--fg-muted); }

  .disclaimer {
    margin: clamp(32px, 4vw, 48px) 0 0;
    font-size: 0.8125rem;
    color: var(--fg-faint);
  }
</style>
