---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../site.config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { basePath, hasTranslation, htmlLang, langFromUrl, langs, localize, ogLocale, useT } from '../i18n';

interface Props {
  title?: string; // page title; the site name is appended
  description?: string;
  ogImage?: ImageMetadata; // e.g. the project cover
  ogType?: 'website' | 'article';
  preloadImage?: { href: string; srcset?: string; sizes?: string; type?: string }; // LCP hero
}

const lang = langFromUrl(Astro.url);
const t = useT(lang);
const { title, description = t('meta.description'), ogImage, ogType = 'website', preloadImage } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${t('meta.defaultTitle')}`;
// Same page in each language, for hreflang alternates (404 and the English-only podcast have none).
const base = basePath(Astro.url);
const alternates = langs.map((l) => ({ lang: l, href: new URL(localize(base, l), Astro.site).href }));
const canonical = new URL(localize(base, lang), Astro.site);
const noTwin = Astro.url.pathname.startsWith('/404') || !hasTranslation(base);
const og = ogImage ? await getImage({ src: ogImage, width: 1200, height: 630, fit: 'cover', format: 'jpg' }) : undefined;
const ogUrl = og ? new URL(og.src, Astro.site).href : undefined;
---

<!doctype html>
<html lang={htmlLang[lang]} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      !noTwin &&
        alternates.map((a) => <link rel="alternate" hreflang={htmlLang[a.lang]} href={a.href} />)
    }
    {!noTwin && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0b0b0c" />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[lang === 'en' ? 'zh' : 'en']} />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    {ogUrl && <meta property="og:image:width" content="1200" />}
    {ogUrl && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogUrl ? 'summary_large_image' : 'summary'} />

    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          href={preloadImage.href}
          imagesrcset={preloadImage.srcset}
          imagesizes={preloadImage.sizes}
          type={preloadImage.type}
          fetchpriority="high"
        />
      )
    }

    <!-- Theme: dark by default; remembers the visitor's choice. Runs before paint to avoid a flash. -->
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('skip')}</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
