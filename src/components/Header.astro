---
import { site, nav } from '../site.config';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
  <div class="bar container">
    <a class="wordmark" href="/" aria-label={`${site.name} — home`}>{site.name}</a>
    <div class="actions">
      <ThemeToggle />
      <a class="icon-btn" href={site.instagram} target="_blank" rel="noopener me" aria-label="Instagram (opens in a new tab)">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5"></rect>
          <circle cx="12" cy="12" r="4.2"></circle>
          <circle cx="17.5" cy="6.5" r="0.9" fill="currentColor" stroke="none"></circle>
        </svg>
      </a>
      <button class="icon-btn menu-btn" type="button" aria-expanded="false" aria-controls="site-menu" aria-label="Open menu">
        <span class="burger" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<div class="menu" id="site-menu" role="dialog" aria-modal="true" aria-label="Site menu" hidden>
  <div class="menu-backdrop" data-close></div>
  <nav class="menu-panel" aria-label="Primary">
    <button class="icon-btn close-btn" type="button" aria-label="Close menu" data-close>
      <svg width="22" height="22" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M5 5l14 14M19 5L5 19"></path>
      </svg>
    </button>
    <ul>
      {
        nav.map((item) => (
          <li>
            <a href={item.href} aria-current={item.href === path ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="menu-foot">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={site.instagram} target="_blank" rel="noopener">Instagram</a>
    </div>
  </nav>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
  }
  .bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  :global(.icon-btn) {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    background: none;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    color: var(--fg);
    transition: background-color 0.2s var(--ease);
  }
  :global(.icon-btn:hover) {
    background: var(--bg-elev);
  }
  .burger {
    display: grid;
    gap: 5px;
    width: 24px;
  }
  .burger span {
    height: 2px;
    background: currentColor;
  }

  /* Right-side panel menu */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 100;
  }
  .menu[hidden] {
    display: none;
  }
  .menu-backdrop {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.5);
    animation: fade 0.3s var(--ease);
  }
  .menu-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(520px, 100%);
    background: var(--bg-elev);
    padding: 96px clamp(28px, 6vw, 64px) 40px;
    display: flex;
    flex-direction: column;
    animation: slide 0.4s var(--ease);
  }
  .close-btn {
    position: absolute;
    top: 22px;
    right: clamp(16px, 4vw, 40px);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  ul a {
    display: inline-block;
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3.25rem);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-muted);
    transition: color 0.2s var(--ease), transform 0.3s var(--ease);
  }
  ul a:hover,
  ul a:focus-visible,
  ul a[aria-current='page'] {
    color: var(--fg);
    transform: translateX(6px);
  }
  .menu-foot {
    margin-top: auto;
    display: grid;
    gap: 6px;
    font-size: 0.875rem;
    color: var(--fg-muted);
  }
  .menu-foot a:hover {
    color: var(--fg);
  }
  @keyframes slide {
    from {
      transform: translateX(100%);
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn')!;
  const menu = document.getElementById('site-menu')!;
  const panel = menu.querySelector<HTMLElement>('.menu-panel')!;

  const focusables = () =>
    Array.from(panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'));

  function open() {
    menu.hidden = false;
    btn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    focusables()[1]?.focus(); // first nav link (index 0 is the close button)
  }
  function close() {
    menu.hidden = true;
    btn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    btn.focus();
  }

  btn.addEventListener('click', open);
  menu.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', close));
  // Same-page anchors (e.g. /#work from the home page) should still close the panel.
  panel.querySelectorAll('ul a').forEach((a) => a.addEventListener('click', () => !menu.hidden && close()));

  menu.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') return close();
    if (e.key !== 'Tab') return;
    const items = focusables();
    const first = items[0];
    const last = items[items.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });
</script>
