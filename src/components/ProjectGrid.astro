---
// Square project grid with optional category filter (progressive enhancement:
// without JS every project is shown and the filter bar stays hidden).
import { Picture } from 'astro:assets';
import { categories } from '../site.config';
import { projectCover, type Project } from '../lib/photos';
import { langFromUrl, localize, useT, type Key } from '../i18n';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const lang = langFromUrl(Astro.url);
const t = useT(lang);
const used = categories.filter((c) => projects.some((p) => p.data.categories.includes(c)));
const sizes = '(max-width: 559px) calc(100vw - 32px), (max-width: 1023px) 50vw, min(33vw, 540px)';
---

<div class="pgrid" data-pgrid>
  {
    used.length > 1 && (
      <div class="pgrid__filters" role="group" aria-label={t('grid.filterLabel')} data-filters hidden>
        <button type="button" class="pgrid__filter" data-filter="all" aria-pressed="true">
          {t('grid.all')}
        </button>
        {used.map((c) => (
          <button type="button" class="pgrid__filter" data-filter={c} aria-pressed="false">
            {t(`cat.${c}` as Key)}
          </button>
        ))}
      </div>
    )
  }

  <p
    class="visually-hidden"
    aria-live="polite"
    data-status
    data-template={t('grid.status')}
    data-one={t('grid.project')}
    data-many={t('grid.projects')}
    data-all-label={t('grid.allCategories')}
  >
  </p>

  <ul class="pgrid__list" role="list">
    {
      projects.map((p) => {
        const cover = projectCover(p);
        return (
          <li class="pgrid__item" data-categories={p.data.categories.join('|')}>
            <a class="pgrid__tile" href={localize(`/projects/${p.id}`, lang)}>
              <div class="pgrid__media">
                <Picture
                  src={cover.src}
                  alt={cover.alt}
                  formats={['webp']}
                  fallbackFormat="webp"
                  widths={[400, 600, 800, 1200]}
                  sizes={sizes}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="pgrid__caption">
                <h3 class="pgrid__title">{p.data.title}</h3>
                {p.data.year && <p class="pgrid__year">{p.data.year}</p>}
              </div>
            </a>
          </li>
        );
      })
    }
  </ul>
</div>

<style>
  .pgrid__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 4px;
    margin: 0 0 clamp(28px, 4vw, 48px);
  }
  .pgrid__filters[hidden] {
    display: none;
  }
  .pgrid__filter {
    padding: 8px 14px;
    border: 1px solid transparent;
    border-radius: 999px;
    background: none;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--fg-muted);
    cursor: pointer;
    transition:
      color 0.25s var(--ease),
      border-color 0.25s var(--ease);
  }
  .pgrid__filter:hover {
    color: var(--fg);
  }
  .pgrid__filter[aria-pressed='true'] {
    color: var(--fg);
    border-color: var(--line);
  }

  .pgrid__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(16px, 2.6vw, 40px);
  }
  @media (max-width: 1023px) {
    .pgrid__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 559px) {
    .pgrid__list {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
  .pgrid__item[hidden] {
    display: none;
  }

  .pgrid__tile {
    position: relative;
    display: block;
    color: inherit;
  }
  .pgrid__tile:focus-visible {
    outline-offset: 4px;
  }
  .pgrid__media {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--bg-elev);
  }
  .pgrid__media :global(picture) {
    display: contents;
  }
  .pgrid__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 1.1s var(--ease),
      filter 0.6s var(--ease);
  }

  .pgrid__title {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.4vw, 1.35rem);
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1.25;
  }
  .pgrid__year {
    margin: 6px 0 0;
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  /* Default (touch / small screens): caption sits below the image, always visible. */
  .pgrid__caption {
    padding-top: 14px;
  }
  .pgrid__year {
    color: var(--fg-muted);
  }

  /* Pointer devices on wider screens: caption is revealed over the image on hover/focus. */
  @media (hover: hover) and (min-width: 761px) {
    .pgrid__caption {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: clamp(18px, 2vw, 28px);
      color: #fff;
      background: linear-gradient(to top, rgb(0 0 0 / 0.7) 0%, rgb(0 0 0 / 0.15) 45%, transparent 70%);
      opacity: 0;
      transition: opacity 0.5s var(--ease);
    }
    .pgrid__caption > * {
      transform: translateY(8px);
      transition: transform 0.6s var(--ease);
    }
    .pgrid__year {
      color: rgb(255 255 255 / 0.75);
    }
    .pgrid__tile:hover .pgrid__caption,
    .pgrid__tile:focus-visible .pgrid__caption {
      opacity: 1;
    }
    .pgrid__tile:hover .pgrid__caption > *,
    .pgrid__tile:focus-visible .pgrid__caption > * {
      transform: none;
    }
    .pgrid__tile:hover .pgrid__media :global(img),
    .pgrid__tile:focus-visible .pgrid__media :global(img) {
      transform: scale(1.04);
    }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-pgrid]')) {
    const bar = root.querySelector<HTMLElement>('[data-filters]');
    if (!bar) continue;
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const items = [...root.querySelectorAll<HTMLElement>('[data-categories]')];
    const status = root.querySelector<HTMLElement>('[data-status]');
    bar.hidden = false;

    const apply = (filter: string) => {
      let shown = 0;
      for (const item of items) {
        const match = filter === 'all' || item.dataset.categories!.split('|').includes(filter);
        item.hidden = !match;
        if (match) shown++;
      }
      for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.filter === filter));
      if (status) {
        // Strings come from data attributes so the same script works on the English and Chinese pages.
        const d = status.dataset;
        const btn = buttons.find((b) => b.dataset.filter === filter);
        const label = filter === 'all' ? d.allLabel : btn?.textContent?.trim() || filter;
        status.textContent = (d.template ?? '')
          .replace('{n}', String(shown))
          .replace('{projects}', (shown === 1 ? d.one : d.many) ?? '')
          .replace('{label}', label ?? '');
      }
    };

    bar.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
      if (btn) apply(btn.dataset.filter!);
    });
  }
</script>
