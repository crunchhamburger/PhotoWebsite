---
/**
 * Full-screen photo viewer (vanilla JS, no dependencies).
 * Enhances every `a[data-lightbox-item]` on the page. Without JS those links
 * simply open the large image.
 */
---

<dialog class="lightbox" aria-label="Photo viewer" data-lightbox>
  <div class="stage" data-stage>
    <figure class="figure">
      <img class="image" alt="" data-image decoding="async" />
      <figcaption class="caption">
        <span class="alt" data-caption></span>
        <span class="counter" aria-live="polite" data-counter></span>
      </figcaption>
    </figure>
  </div>

  <button class="ctl close" type="button" aria-label="Close viewer" data-close>
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"
      ><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="1.4" fill="none"></path></svg
    >
  </button>
  <button class="ctl nav prev" type="button" aria-label="Previous photograph" data-prev>
    <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"
      ><path d="M15 4l-8 8 8 8" stroke="currentColor" stroke-width="1.2" fill="none"></path></svg
    >
  </button>
  <button class="ctl nav next" type="button" aria-label="Next photograph" data-next>
    <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"
      ><path d="M9 4l8 8-8 8" stroke="currentColor" stroke-width="1.2" fill="none"></path></svg
    >
  </button>
</dialog>

<script>
  type Item = { el: HTMLAnchorElement; full: string; srcset: string; w: number; h: number; alt: string };

  function init() {
    const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
    if (!dialog || typeof dialog.showModal !== 'function') return; // fall back to plain links

    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[data-lightbox-item]'));
    if (!links.length) return;

    const items: Item[] = links.map((el) => ({
      el,
      full: el.dataset.full || el.href,
      srcset: el.dataset.srcset || '',
      w: Number(el.dataset.width) || 0,
      h: Number(el.dataset.height) || 0,
      alt: el.dataset.alt || '',
    }));

    const stage = dialog.querySelector<HTMLElement>('[data-stage]')!;
    const img = dialog.querySelector<HTMLImageElement>('[data-image]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-caption]')!;
    const counter = dialog.querySelector<HTMLElement>('[data-counter]')!;
    const btnClose = dialog.querySelector<HTMLButtonElement>('[data-close]')!;
    const btnPrev = dialog.querySelector<HTMLButtonElement>('[data-prev]')!;
    const btnNext = dialog.querySelector<HTMLButtonElement>('[data-next]')!;

    if (items.length < 2) {
      btnPrev.hidden = true;
      btnNext.hidden = true;
    }

    let index = 0;
    let trigger: HTMLElement | null = null;
    const SIZES = '100vw';
    const preloaded = new Set<number>();

    function preload(i: number) {
      if (preloaded.has(i)) return;
      preloaded.add(i);
      const it = items[i];
      const pre = new Image();
      pre.decoding = 'async';
      if (it.srcset) {
        pre.sizes = SIZES;
        pre.srcset = it.srcset;
      }
      pre.src = it.full;
    }

    function show(i: number) {
      index = (i + items.length) % items.length;
      const it = items[index];
      img.classList.remove('is-loaded');
      // Clear first so the previous photo never flashes with the new dimensions.
      img.removeAttribute('srcset');
      img.width = it.w;
      img.height = it.h;
      img.alt = it.alt;
      img.sizes = SIZES;
      if (it.srcset) img.srcset = it.srcset;
      img.src = it.full;
      if (img.complete && img.naturalWidth) img.classList.add('is-loaded');
      caption.textContent = it.alt;
      counter.textContent = `${index + 1} / ${items.length}`;
      preload(index);
      if (items.length > 1) {
        preload((index + 1) % items.length);
        preload((index - 1 + items.length) % items.length);
      }
    }

    img.addEventListener('load', () => img.classList.add('is-loaded'));

    function open(i: number, from: HTMLElement) {
      trigger = from;
      show(i);
      document.documentElement.classList.add('lightbox-open');
      dialog!.showModal();
      btnClose.focus({ preventScroll: true });
    }

    function close() {
      if (!dialog!.open) return;
      dialog!.close();
    }

    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('lightbox-open');
      img.removeAttribute('src');
      img.removeAttribute('srcset');
      if (trigger) trigger.focus({ preventScroll: true });
      trigger = null;
    });

    links.forEach((el, i) => {
      el.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || (e as MouseEvent).button !== 0) return; // allow "open in new tab"
        e.preventDefault();
        open(i, el);
      });
    });

    btnClose.addEventListener('click', close);
    btnPrev.addEventListener('click', () => show(index - 1));
    btnNext.addEventListener('click', () => show(index + 1));

    // Keyboard: Esc (native "cancel"), arrows, and a focus trap across the controls.
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        show(index - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        show(index + 1);
      } else if (e.key === 'Escape') {
        e.preventDefault();
        close();
      } else if (e.key === 'Tab') {
        const focusables = [btnClose, btnPrev, btnNext].filter((b) => !b.hidden);
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        const active = document.activeElement;
        if (e.shiftKey && (active === first || !dialog.contains(active))) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && (active === last || !dialog.contains(active))) {
          e.preventDefault();
          first.focus();
        }
      }
    });

    // Pointer: swipe left/right to navigate, swipe down to close, tap backdrop to close.
    let startX = 0;
    let startY = 0;
    let tracking = false;
    let pointerId: number | null = null;
    const THRESHOLD = 50;

    stage.addEventListener('pointerdown', (e) => {
      if (!e.isPrimary || (e.pointerType === 'mouse' && e.button !== 0)) return;
      tracking = true;
      pointerId = e.pointerId;
      startX = e.clientX;
      startY = e.clientY;
    });

    stage.addEventListener('pointerup', (e) => {
      if (!tracking || e.pointerId !== pointerId) return;
      tracking = false;
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      const ax = Math.abs(dx);
      const ay = Math.abs(dy);
      if (ax > THRESHOLD && ax > ay) {
        show(dx < 0 ? index + 1 : index - 1);
      } else if (dy > THRESHOLD * 1.6 && ay > ax) {
        close();
      } else if (ax < 6 && ay < 6 && e.target !== img) {
        close(); // a tap/click on the dark backdrop
      }
    });

    stage.addEventListener('pointercancel', () => {
      tracking = false;
    });

    // Prevent native image dragging from hijacking mouse swipes.
    img.addEventListener('dragstart', (e) => e.preventDefault());
  }

  init();
</script>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--overlay);
    color: var(--fg);
    overflow: hidden;
  }
  .lightbox::backdrop {
    background: var(--overlay);
  }
  .lightbox[open] {
    animation: lb-fade 0.35s var(--ease);
  }
  @keyframes lb-fade {
    from {
      opacity: 0;
    }
  }

  :global(html.lightbox-open),
  :global(html.lightbox-open body) {
    overflow: hidden;
  }

  .stage {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: clamp(56px, 7vh, 88px) clamp(12px, 7vw, 120px) clamp(72px, 10vh, 104px);
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }
  .figure {
    margin: 0;
    width: 100%;
    height: 100%;
    min-height: 0;
    display: grid;
    place-items: center;
  }
  .image {
    max-width: 100%;
    max-height: calc(100dvh - clamp(56px, 7vh, 88px) - clamp(72px, 10vh, 104px));
    width: auto;
    height: auto;
    object-fit: contain;
    background: var(--bg-elev);
    opacity: 0;
    transition: opacity 0.45s var(--ease);
    -webkit-user-drag: none;
  }
  .image.is-loaded {
    opacity: 1;
    background: transparent;
  }
  .caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    padding: 20px clamp(16px, 4vw, 48px) max(20px, env(safe-area-inset-bottom));
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--fg-muted);
    pointer-events: none;
  }
  .alt {
    max-width: 70ch;
  }
  .counter {
    flex: none;
    font-family: var(--font-display);
    letter-spacing: 0.24em;
    font-variant-numeric: tabular-nums;
    color: var(--fg);
  }

  .ctl {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--fg);
    cursor: pointer;
    opacity: 0.72;
    transition:
      opacity 0.25s var(--ease),
      background-color 0.25s var(--ease);
  }
  .ctl:hover,
  .ctl:focus-visible {
    opacity: 1;
    background: rgb(127 127 127 / 0.14);
  }
  .ctl[hidden] {
    display: none;
  }
  .close {
    top: max(12px, env(safe-area-inset-top));
    right: clamp(8px, 2vw, 28px);
  }
  .nav {
    top: 50%;
    transform: translateY(-50%);
  }
  .prev {
    left: clamp(4px, 2vw, 28px);
  }
  .next {
    right: clamp(4px, 2vw, 28px);
  }

  @media (max-width: 640px) {
    /* Swipe is the primary gesture on phones; keep arrows small and out of the way. */
    .nav {
      top: auto;
      bottom: 52px;
      transform: none;
      width: 44px;
      height: 44px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox[open] {
      animation: none;
    }
    .image,
    .ctl {
      transition: none;
    }
  }
</style>
