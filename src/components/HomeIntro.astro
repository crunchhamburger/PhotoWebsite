---
// Opening statement on the home page: a three-line headline that rises line by line (the middle line
// outlined), a short intro, a live New York clock and a scroll cue down to the work.
import { langFromUrl, localize, useT } from '../i18n';

const lang = langFromUrl(Astro.url);
const t = useT(lang);
const lines = [t('intro.l1'), t('intro.l2'), t('intro.l3')];
---

<section class="hi container">
  <div class="hi__grid">
    <p class="hi__title" aria-label={lines.join(' ')}>
      {
        lines.map((line, i) => (
          <span class:list={['hi__line', `hi__line--${i}`]} aria-hidden="true">
            <span style={`--i: ${i}`}>{line}</span>
          </span>
        ))
      }
    </p>
    <div class="hi__side">
      <p class="hi__lede">{t('intro.lede')}</p>
      <p class="hi__meta">
        <span class="hi__live" aria-hidden="true"></span>
        {t('intro.based')}
        <span class="hi__sep" aria-hidden="true">·</span>
        <span>
          {t('intro.clock')}
          <time class="hi__clock" data-clock data-locale={lang === 'zh' ? 'zh-CN' : 'en-US'}></time>
        </span>
      </p>
    </div>
  </div>
  <a class="hi__cue" href={localize('/#work', lang)}>
    <span>{t('intro.scroll')}</span>
    <span class="hi__cue-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hi {
    position: relative;
    padding-block: clamp(24px, 5vw, 72px) clamp(28px, 4vw, 56px);
  }
  .hi__grid {
    display: grid;
    gap: clamp(24px, 4vw, 48px);
    align-items: end;
  }
  @media (min-width: 960px) {
    .hi__grid {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    }
  }
  .hi__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 0.8rem + 9.5vw, 10.5rem);
    font-weight: 300;
    line-height: 0.9;
    letter-spacing: -0.045em;
  }
  :global(:lang(zh)) .hi__title {
    letter-spacing: 0;
    line-height: 1.05;
    font-weight: 400;
  }
  .hi__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }
  .hi__line > span {
    display: inline-block;
    animation: hi-rise 1.2s cubic-bezier(0.2, 0.75, 0.15, 1) both;
    animation-delay: calc(0.15s + var(--i) * 0.14s);
  }
  .hi__line--1 > span {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--fg);
  }
  .hi__line--2 > span {
    padding-left: clamp(0px, 8vw, 140px);
  }
  @keyframes hi-rise {
    from {
      transform: translateY(105%) skewY(6deg);
    }
  }
  .hi__side {
    display: grid;
    gap: 22px;
    max-width: 30rem;
    animation: hi-fade 1s var(--ease) 0.7s both;
  }
  @keyframes hi-fade {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
  .hi__lede {
    margin: 0;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.2rem);
    line-height: 1.65;
    color: var(--fg-muted);
  }
  .hi__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .hi__live {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 var(--accent);
    animation: hi-pulse 2s ease-out infinite;
  }
  @keyframes hi-pulse {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 60%, transparent);
    }
    100% {
      box-shadow: 0 0 0 10px transparent;
    }
  }
  .hi__sep {
    color: var(--fg-faint);
  }
  .hi__clock {
    margin-left: 8px;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }
  .hi__cue {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(8px, 2vw, 24px);
    display: none;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display);
    font-size: 0.6875rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--fg-muted);
    writing-mode: vertical-rl;
  }
  @media (min-width: 960px) {
    .hi__cue {
      display: inline-flex;
      top: clamp(24px, 5vw, 72px);
      bottom: auto;
    }
  }
  .hi__cue:hover {
    color: var(--fg);
  }
  .hi__cue-line {
    position: relative;
    width: 1px;
    height: 64px;
    overflow: hidden;
    background: var(--line);
  }
  .hi__cue-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--fg);
    animation: hi-drip 2.2s cubic-bezier(0.7, 0, 0.2, 1) infinite;
  }
  @keyframes hi-drip {
    0% {
      transform: translateY(-100%);
    }
    60%,
    100% {
      transform: translateY(100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hi__line > span,
    .hi__side,
    .hi__live,
    .hi__cue-line::after {
      animation: none;
    }
  }
</style>

<script>
  // Live New York time, updated every 15 s.
  for (const el of document.querySelectorAll<HTMLTimeElement>('[data-clock]')) {
    const fmt = new Intl.DateTimeFormat(el.dataset.locale, {
      timeZone: 'America/New_York',
      hour: 'numeric',
      minute: '2-digit',
    });
    const tick = () => {
      const now = new Date();
      el.textContent = fmt.format(now);
      el.dateTime = now.toISOString();
    };
    tick();
    setInterval(tick, 15000);
  }
</script>
