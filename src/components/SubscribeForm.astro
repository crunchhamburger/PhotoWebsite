---
/**
 * Email sign-up for the Market Brief, handled by Buttondown (buttondown.com/michaelwang8111).
 * Buttondown keeps the list, sends the confirmation email (double opt-in) and adds one-click
 * unsubscribe; the brief pipeline creates each episode's email through Buttondown's API.
 * (Tags by language need Buttondown's paid plan, so every subscriber gets the bilingual email.)
 * Without JavaScript the form does a normal POST and Buttondown shows its own confirmation page.
 */
import { site } from '../site.config';

const BUTTONDOWN = 'https://buttondown.com/api/emails/embed-subscribe/michaelwang8111';
import { langFromUrl, useT } from '../i18n';

const lang = langFromUrl(Astro.url);
const t = useT(lang);
---

{
  (
    <form
      class="subscribe"
      method="POST"
      action={BUTTONDOWN}
      target="_blank"
      data-subscribe
      data-msg-sending={t('subscribe.sending')}
      data-msg-success={t('subscribe.success')}
      data-msg-error={t('subscribe.error', { email: site.email })}
    >
      <input type="hidden" name="embed" value="1" />

      <p class="heading">{t('subscribe.heading')}</p>
      <div class="row">
        <label class="visually-hidden" for="subscribe-email">{t('subscribe.email')}</label>
        <input
          id="subscribe-email"
          name="email"
          type="email"
          inputmode="email"
          autocomplete="email"
          placeholder={t('subscribe.email')}
          required
        />
        <button type="submit">{t('subscribe.button')}</button>
      </div>
      <p class="note">{t('subscribe.note')}</p>
      <p class="status" role="status" aria-live="polite" data-status></p>
    </form>
  )
}

<style>
  .subscribe {
    margin-top: 28px;
    max-width: 520px;
  }
  .heading {
    margin: 0 0 10px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .row {
    display: flex;
    gap: 8px;
  }
  input[type='email'] {
    flex: 1;
    min-width: 0;
    font: inherit;
    font-size: 1rem;
    color: var(--fg);
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--line);
    border-radius: 0;
    padding: 10px 0;
  }
  input[type='email']:focus-visible {
    outline: none;
    border-bottom-color: var(--accent);
    box-shadow: 0 1px 0 0 var(--accent);
  }
  button {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: 10px 20px;
    background: transparent;
    color: var(--fg);
    border: 1px solid var(--fg);
    cursor: pointer;
    transition: background-color 0.25s var(--ease), color 0.25s var(--ease);
  }
  button:hover {
    background: var(--fg);
    color: var(--bg);
  }
  button:disabled {
    opacity: 0.5;
    cursor: progress;
  }
  .note {
    margin: 10px 0 0;
    font-size: 0.8125rem;
    color: var(--fg-muted);
  }
  .status {
    min-height: 1.4em;
    margin: 6px 0 0;
    font-size: 0.875rem;
    color: var(--fg-muted);
  }
  .status[data-state='success'] {
    color: var(--fg);
  }
  .status[data-state='error'] {
    color: #e5676b;
  }
  .hp {
    position: absolute;
    left: -10000px;
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-subscribe]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const set = (state: string, text: string) => {
      status.dataset.state = state;
      status.textContent = text;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      button.disabled = true;
      set('sending', form.dataset.msgSending ?? '');
      try {
        // Buttondown's embed endpoint doesn't send CORS headers, so the response is opaque:
        // a network error is the only failure we can see. Buttondown emails a confirmation link.
        await fetch(form.action, { method: 'POST', body: new FormData(form), mode: 'no-cors' });
        form.reset();
        set('success', form.dataset.msgSuccess ?? '');
      } catch {
        set('error', form.dataset.msgError ?? '');
      } finally {
        button.disabled = false;
      }
    });
  });
</script>
