---
// Rendered by src/pages/podcast/index.astro and src/pages/zh/podcast/index.astro.
import BaseLayout from '../layouts/BaseLayout.astro';
import EpisodeMeta from '../components/EpisodeMeta.astro';
import VoicePlayer from '../components/VoicePlayer.astro';
import SpeedControl from '../components/SpeedControl.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import { podcast } from '../site.config';
import { getEpisodes, audioPath, episodeText, episodeHref, zhVoices } from '../lib/podcast';
import { langFromUrl, useT } from '../i18n';

const lang = langFromUrl(Astro.url);
const t = useT(lang);
const episodes = await getEpisodes();
// Title split for the entrance animation: words in English, characters in Chinese.
const title = t('podcast.title');
const titleParts = lang === 'zh' ? [...title] : title.split(' ');
---
<BaseLayout title={t('podcast.eyebrow')} description={t('podcast.description')}>
  <link slot="head" rel="alternate" type="application/rss+xml" title={podcast.title} href="/podcast/rss.xml" />

  <section class="podcast container">
    <header class="intro">
      <p class="eyebrow enter" style="--d: 0.15s">
        <span class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
        {t('podcast.eyebrow')}
      </p>
      <h1 class="title" aria-label={title}>
        {titleParts.map((part, i) => (
          <span class="w" aria-hidden="true">
            <span style={`--i: ${i}`}>{part}</span>
          </span>
        ))}
      </h1>
      <p class="lede enter" style="--d: 0.75s">{t('podcast.description')}</p>
      <a class="rss enter" style="--d: 0.85s" href="/podcast/rss.xml">
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false">
          <path d="M5 11a8 8 0 0 1 8 8M5 5a14 14 0 0 1 14 14" />
          <circle cx="6" cy="18" r="1.4" />
        </svg>
        {t('podcast.rss')}
      </a>
      <div class="enter" style="--d: 0.95s">
        <SubscribeForm />
      </div>
    </header>

    {episodes.length > 0 && (
      <div class="toolbar">
        <SpeedControl />
      </div>
    )}

    {episodes.length === 0 ? (
      <p class="empty">{t('podcast.empty')}</p>
    ) : (
      <ol class="episodes" aria-label={t('podcast.listLabel')}>
        {episodes.map((ep) => {
          const { title, headline } = episodeText(ep, lang);
          const href = episodeHref(ep, lang);
          return (
            <li>
              <article class="episode" aria-labelledby={`ep-${ep.id}`}>
                <EpisodeMeta episode={ep} />
                <h2 class="headline" id={`ep-${ep.id}`}>
                  <a href={href}>{headline}</a>
                </h2>
                {lang === 'zh' && zhVoices(ep).length > 0 ? (
                  <VoicePlayer voices={zhVoices(ep)} label={t('podcast.play', { title })} preload="none" />
                ) : (
                  <audio controls preload="none" src={audioPath(ep, lang)} aria-label={t('podcast.play', { title })}></audio>
                )}
                <a class="more eyebrow" href={href} aria-label={t('podcast.showNotesFor', { title })}>
                  {t('podcast.showNotes')} <span aria-hidden="true">→</span>
                </a>
              </article>
            </li>
          );
        })}
      </ol>
    )}

    <p class="disclaimer">{t('podcast.disclaimer')}</p>
  </section>
</BaseLayout>

<style>
  .podcast {
    max-width: calc(860px + 2 * var(--gutter));
    padding-block: clamp(40px, 7vw, 104px) 0;
  }

  .intro .eyebrow {
    margin: 0 0 18px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .title {
    font-size: clamp(2.4rem, 1.4rem + 4.4vw, 5.25rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.02;
  }

  /* ---------- Entrance choreography ---------- */
  /* Title: each word (Chinese: each character) rises from behind a mask, staggered. */
  .title .w {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.08em; /* keep descenders inside the mask */
    margin-right: 0.22em;
  }
  :global(:lang(zh)) .title .w {
    margin-right: 0;
  }
  .title .w > span {
    display: inline-block;
    animation: rise-mask 1.1s cubic-bezier(0.2, 0.75, 0.15, 1) both;
    animation-delay: calc(0.3s + var(--i) * 0.11s);
  }
  @keyframes rise-mask {
    from {
      transform: translateY(105%) rotate(4deg);
      opacity: 0;
    }
    40% {
      opacity: 1;
    }
  }
  /* Everything else in the intro fades up in sequence (--d sets each delay). */
  .enter {
    animation: fade-up 0.9s var(--ease) both;
    animation-delay: var(--d, 0s);
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(18px);
      filter: blur(4px);
    }
  }
  /* A small live equalizer beside the eyebrow. */
  .eq {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 12px;
  }
  .eq i {
    width: 2px;
    height: 100%;
    background: var(--accent);
    transform-origin: bottom;
    animation: eq 1.1s ease-in-out infinite alternate;
  }
  .eq i:nth-child(1) { animation-duration: 0.9s; }
  .eq i:nth-child(2) { animation-duration: 1.25s; animation-delay: -0.4s; }
  .eq i:nth-child(3) { animation-duration: 0.75s; animation-delay: -0.2s; }
  .eq i:nth-child(4) { animation-duration: 1.1s; animation-delay: -0.6s; }
  .eq i:nth-child(5) { animation-duration: 0.95s; animation-delay: -0.3s; }
  @keyframes eq {
    from { transform: scaleY(0.2); }
    to { transform: scaleY(1); }
  }
  /* Episodes reveal as they scroll into view (scroll-driven animations; elsewhere they just show). */
  @supports (animation-timeline: view()) {
    .episodes > li {
      animation: fade-up linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 55%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .title .w > span,
    .enter,
    .episodes > li {
      animation: none;
    }
    .eq i {
      animation: none;
      transform: scaleY(0.6);
    }
  }
  .lede {
    margin: clamp(20px, 2.6vw, 32px) 0 0;
    max-width: 38em;
    font-size: clamp(1rem, 0.96rem + 0.25vw, 1.15rem);
    line-height: 1.7;
    font-weight: 300;
    color: var(--fg-muted);
    text-wrap: pretty;
  }
  .rss {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 22px;
    font-size: 0.875rem;
    color: var(--fg);
    border-bottom: 1px solid var(--line);
    padding-bottom: 2px;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .rss:hover { color: var(--accent); border-color: currentColor; }
  .rss svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  .rss circle { fill: currentColor; stroke: none; }

  .toolbar {
    display: flex;
    justify-content: flex-end;
    margin-top: clamp(32px, 5vw, 56px);
  }
  .toolbar + .episodes {
    margin-top: 18px;
  }
  .episodes {
    list-style: none;
    margin: clamp(40px, 6vw, 72px) 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .episode {
    display: grid;
    gap: 14px;
    padding-block: clamp(24px, 3.5vw, 40px);
    border-bottom: 1px solid var(--line);
  }
  .headline {
    font-size: clamp(1.2rem, 1.11rem + 0.42vw, 1.5rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.005em;
    text-wrap: pretty;
  }
  .headline a {
    background: linear-gradient(currentColor, currentColor) no-repeat left bottom / 0 1px;
    transition: background-size 0.5s var(--ease), color 0.25s var(--ease);
  }
  .headline a:hover { background-size: 100% 1px; }

  audio {
    display: block;
    width: 100%;
    height: 44px;
    margin-top: 4px;
  }

  .more {
    justify-self: start;
    display: inline-flex;
    gap: 0.6em;
    font-size: 0.6875rem;
    transition: color 0.2s var(--ease);
  }
  .more:hover { color: var(--fg); }

  .empty { margin-top: 48px; color: var(--fg-muted); }

  .disclaimer {
    margin: clamp(32px, 4vw, 48px) 0 0;
    font-size: 0.8125rem;
    color: var(--fg-faint);
  }
</style>
